---
// Ruta de aprendizaje: la línea de tiempo con las 8 clases del curso.
import plan from '../config/plan.json';
import progreso from '../config/progreso.json';
import ClassCard from './ClassCard.astro';

const claseActual = progreso.claseActual;

type Estado = 'completada' | 'actual' | 'bloqueada';
type ClasePlan = (typeof plan)['clases'][number];

const estadoDe = (n: number): Estado =>
  n < claseActual ? 'completada' : n === claseActual ? 'actual' : 'bloqueada';

const clases: Array<ClasePlan & { estado: Estado }> = plan.clases.map((c) => ({
  ...c,
  estado: estadoDe(c.numero),
}));
---

<div class="relative" data-timeline>
  <span aria-hidden="true" class="rail rail--borde"></span>
  <span aria-hidden="true" class="rail rail--progreso" data-rail-progreso></span>

  <ol aria-label="Ruta de aprendizaje del curso">
    {
      clases.map((c) => (
        <ClassCard
          numero={c.numero}
          red={c.red}
          titulo={c.titulo}
          temas={c.temas}
          estado={c.estado}
        />
      ))
    }
  </ol>
</div>

<script>
  let listo = false;

  function ajustarRuta() {
    const contenedor = document.querySelector<HTMLElement>('[data-timeline]');
    const activa = contenedor?.querySelector<HTMLElement>('li[data-estado="actual"]');
    const railProgreso = contenedor?.querySelector<HTMLElement>('[data-rail-progreso]');
    if (!contenedor || !activa || !railProgreso) return;
    railProgreso.style.height = `${Math.max(0, activa.offsetTop)}px`;
  }

  // Con ClientRouter el DOM se reconstruye en cada navegación; `astro:page-load`
  // se dispara en la carga inicial y al volver a esta página.
  function conectarRuta() {
    if (listo) return;
    listo = true;
    ajustarRuta();
    window.addEventListener('resize', ajustarRuta, { passive: true });
  }

  document.addEventListener('astro:page-load', conectarRuta);
  conectarRuta();
</script>