---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import sitio from '../config/sitio.json';
import ThemeToggle from './ThemeToggle.astro';
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from "@vercel/speed-insights/astro"

const {
  titulo = 'Inicio',
  descripcion = sitio.subtitulo,
  rutaActual = '/',
} = Astro.props;

const tituloPagina = titulo === 'Inicio' ? `${sitio.curso}` : `${titulo} · ${sitio.curso}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    <title>{tituloPagina}</title>

    <!-- Aplica el tema elegido antes de pintar, para evitar parpadeo. -->
    <script is:inline>
      (function () {
        function oscuroElegido() {
          try {
            var valor = localStorage.getItem('tema-conecta');
            if (valor === 'oscuro') return true;
            if (valor === 'claro') return false;
          } catch (e) {
            /* modo local inaccesible: se usa la preferencia del sistema */
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches;
        }

        function aplicarTema() {
          document.documentElement.classList.toggle('dark', oscuroElegido());
        }

        aplicarTema();

        // Con transiciones de vista el router sustituye los atributos de <html>
        // por los del documento entrante (allí la clase "dark" no está, porque la
        // añade este mismo script en el navegador). Sin esto, el tema se perdía al
        // navegar: se reinyecta antes del intercambio y se revisa después.
        document.addEventListener('astro:before-swap', function (event) {
          if (event.newDocument && oscuroElegido()) {
            event.newDocument.documentElement.classList.add('dark');
          }
        });
        document.addEventListener('astro:after-swap', aplicarTema);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido-principal">
      Saltar al contenido principal
    </a>

    <header class="cabecera-material">
      <div
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
      >
        <a
          href="/"
          aria-current={rutaActual === '/' ? 'page' : undefined}
          class="marca-sitio text-lg sm:text-xl"
        >
          {sitio.corto}
        </a>
        <ThemeToggle />
      </div>
    </header>

    <main
      id="contenido-principal"
      class="mx-auto max-w-5xl px-4 pb-20 pt-10 sm:px-6 sm:pt-14"
    >
      <slot />
    </main>

    <footer class="border-t border-superficie-borde">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-6 text-sm text-tinta-suave sm:px-6"
      >
        <p>{sitio.curso}</p>
        <p>Repaso y práctica desde casa, después de cada clase.</p>
      </div>
    </footer>

    <script>
      import '../scripts/post-example.js';
    </script>
    <Analytics/>
    <SpeedInsights/>
  </body>
</html>