---
// Contenido interno de una tarjeta de clase (enlace o bloqueada).
import Icon from './Icon.astro';

type Props = {
  numero: number;
  red: string;
  titulo: string;
  temas: string[];
  estado: 'completada' | 'actual' | 'bloqueada';
};

const { numero, red, titulo, temas = [], estado } = Astro.props as Props;

const temasVista = temas.slice(0, 4);
const restantes = temas.length - temasVista.length;
---

<div class="flex flex-col gap-4">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    {
      estado === 'completada' && (
        <span class="capsula capsula--completada">
          <Icon name="checkCircle" size={16} />
          Completada
        </span>
      )
    }
    {
      estado === 'actual' && (
        <span class="capsula capsula--actual">
          <Icon name="play" size={14} />
          Clase de hoy
        </span>
      )
    }
    {
      estado === 'bloqueada' && (
        <span class="capsula capsula--bloqueada">
          <Icon name="lock" size={15} />
          Próximamente
        </span>
      )
    }
    <p class="rumbo-card">Clase {numero} · {red}</p>
  </div>

  <h2 class="tarjeta-titulo">{titulo}</h2>

  <ul class="space-y-2.5">
    {
      temasVista.map((t) => (
        <li class="flex items-start gap-3 text-[0.9375rem]">
          <span
            aria-hidden="true"
            class:list={[
              'mt-2 size-2 shrink-0 rounded-full',
              estado === 'bloqueada' ? 'bg-bloqueo' : 'bg-acento',
            ]}
          ></span>
          <span>{t}</span>
        </li>
      ))
    }
  </ul>

  {
    restantes > 0 && (
      <p class="mas-temas">
        Y {restantes} {restantes === 1 ? 'tema' : 'temas'} más
      </p>
    )
  }
</div>