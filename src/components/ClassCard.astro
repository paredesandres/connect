---
// Tarjeta de una clase en la ruta de aprendizaje.
import Icon from './Icon.astro';
import CardContenido from './CardContenido.astro';

type Props = {
  numero: number;
  red: string;
  titulo: string;
  temas: string[];
  estado: 'completada' | 'actual' | 'bloqueada';
};

const { numero, red, titulo, temas = [], estado } = Astro.props;
const esEnlace = estado !== 'bloqueada';
const href = `/clase/${numero}/`;
---

<li class="relative mb-8 pl-12 last:mb-0 sm:pl-14">
  <!-- Marcador sobre la línea vertical de la ruta -->
  <span
    aria-hidden="true"
    class="absolute left-0 top-1 flex size-10 items-center justify-center rounded-full border border-superficie-borde bg-superficie shadow-sm sm:size-11"
  >
    {estado === 'completada' && <Icon name="checkCircle" size={26} class="text-acento" />}
    {estado === 'actual' && (
      <span class="flex size-4 rounded-full bg-acento">
        <span class="m-auto size-2 rounded-full bg-white dark:bg-[#1a1917]"></span>
      </span>
    )}
    {estado === 'bloqueada' && <Icon name="lock" size={24} class="text-bloqueo" />}
  </span>

  {
    esEnlace ? (
      <a
        href={href}
        class="tarjeta-clase block rounded-2xl border border-superficie-borde bg-superficie p-5 shadow-sm transition-colors hover:border-acento sm:p-6"
        aria-label={`Ir a la clase ${numero}: ${titulo}`}
      >
        <CardContenido numero={numero} red={red} titulo={titulo} temas={temas} estado={estado} />
      </a>
    ) : (
      <div
        aria-disabled="true"
        class="tarjeta-clase rounded-2xl border border-superficie-borde bg-bloqueo-tinte p-5 sm:p-6"
      >
        <CardContenido numero={numero} red={red} titulo={titulo} temas={temas} estado={estado} />
      </div>
    )
  }
</li>