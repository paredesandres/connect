---
// Tarjeta de una clase en la ruta de aprendizaje.
import Icon from './Icon.astro';
import CardContenido from './CardContenido.astro';

type Props = {
  numero: number;
  red: string;
  titulo: string;
  temas: string[];
  estado: 'completada' | 'actual' | 'bloqueada';
};

const { numero, red, titulo, temas = [], estado } = Astro.props;
const esEnlace = estado !== 'bloqueada';
const href = `/clase/${numero}/`;
---

<li class="relative mb-8 pl-12 last:mb-0" data-estado={estado}>
  <span aria-hidden="true" class={`marcador marcador--${estado}`}>
    {estado === 'completada' && <Icon name="check" size={24} />}
    {estado === 'actual' && <span class="size-2.5 rounded-full bg-acento"></span>}
    {estado === 'bloqueada' && <Icon name="lock" size={20} />}
  </span>

  {
    esEnlace ? (
      <a
        href={href}
        class:list={[
          'tarjeta-clase p-5 sm:p-6',
          estado === 'actual' && 'tarjeta-clase--actual',
        ]}
        aria-label={`Ir a la clase ${numero}: ${titulo}`}
      >
        <CardContenido numero={numero} red={red} titulo={titulo} temas={temas} estado={estado} />
      </a>
    ) : (
      <div
        aria-disabled="true"
        class="tarjeta-clase tarjeta-clase--bloqueada p-5 sm:p-6"
      >
        <CardContenido numero={numero} red={red} titulo={titulo} temas={temas} estado={estado} />
      </div>
    )
  }
</li>