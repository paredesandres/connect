---
import Icon from './Icon.astro';

// Nota aclaratoria o mini glosario para términos nuevos.
const { nombre = 'Para recordar' } = Astro.props;
const { icono = 'info' } = Astro.props;
---

<aside class="mt-8 flex flex-col gap-3 rounded-xl border-l-4 border-acento bg-acento-tinte p-5">
  <h3 class="flex items-center gap-3 text-lg font-bold text-acento-texto">
    <Icon name={icono} size={26} />
    <span>{nombre}</span>
  </h3>
  <div class="space-y-3">
    <slot />
  </div>
</aside>