---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Icon from '../../components/Icon.astro';
import Bloqueada from '../../components/Bloqueada.astro';
import Tarea from '../../components/Tarea.astro';
import plan from '../../config/plan.json';
import progreso from '../../config/progreso.json';

type Clase = (typeof plan)['clases'][number];

export function getStaticPaths() {
  return plan.clases.map((c: Clase) => ({
    params: { numero: String(c.numero) },
    props: { clase: c },
  }));
}

const { clase } = Astro.props as { clase: Clase };
const claseActual = progreso.claseActual;
const estado =
  clase.numero < claseActual ? 'completada' : clase.numero === claseActual ? 'actual' : 'bloqueada';

const temasClase = (await getCollection('temas', (t) => t.data.clase === clase.numero)).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const descripcion = `Repaso de la clase ${clase.numero}: ${clase.titulo} (${clase.red}).`;
---

<Layout titulo={`Clase ${clase.numero}: ${clase.titulo}`} descripcion={descripcion}>
  <nav aria-label="Ubicación actual" class="mb-8">
    <a
      href="/"
      class="inline-flex min-h-11 items-center gap-2 rounded-lg px-2 font-bold text-acento-texto no-underline hover:underline"
    >
      <Icon name="atras" size={22} />
      Volver a la ruta de aprendizaje
    </a>
  </nav>

  <header class="mb-8">
    <p class="flex flex-wrap items-center gap-2 text-sm font-bold text-tinta-suave">
      <span>Clase {clase.numero}</span>
      <span aria-hidden="true">·</span>
      <span>{clase.red}</span>
    </p>
    <h1 class="mt-2 text-2xl font-bold sm:text-3xl">{clase.titulo}</h1>
    {
      estado === 'actual' && (
        <p class="btn-acento mt-4 inline-flex items-center gap-2 rounded-lg px-4 py-2 font-bold">
          <Icon name="play" size={20} />
          Clase de hoy
        </p>
      )
    }
    {
      estado === 'completada' && (
        <p class="mt-4 inline-flex items-center gap-2 rounded-lg bg-acento-tinte px-4 py-2 font-bold text-acento-texto">
          <Icon name="checkCircle" size={20} />
          Clase completada
        </p>
      )
    }
  </header>

  {
    estado === 'bloqueada' ? (
      <Bloqueada mensaje="Esta clase todavía no se ha impartido. Estará disponible aquí unos días después de la clase presencial." />
    ) : temasClase.length > 0 ? (
      <>
        <h2 class="text-lg font-bold">Los temas de esta clase</h2>
        <ul class="mt-5 space-y-4">
          {
            temasClase.map((tema) => (
              <li>
                <a
                  href={`/clase/${clase.numero}/${tema.id}/`}
                  class="block rounded-2xl border border-superficie-borde bg-superficie p-5 shadow-sm transition-colors hover:border-acento sm:p-6"
                >
                  <p class="text-base font-bold text-acento-texto no-underline underline-offset-4 hover:underline">
                    {tema.data.titulo}
                  </p>
                  {
                    tema.data.resumen && (
                      <p class="mt-2 text-tinta-suave">{tema.data.resumen}</p>
                    )
                  }
                </a>
              </li>
            ))
          }
        </ul>

        {
          clase.tarea && (
            <Tarea>
              <p>{clase.tarea}</p>
            </Tarea>
          )
        }
      </>
    ) : (
      /* Clase "actual": se acaba de impartir; agenda hasta que se escriba el detalle. */
      <>
        <h2 class="text-lg font-bold">Lo que se vio en esta clase</h2>
        <ol class="mt-5 space-y-4" aria-label="Temas de la clase de hoy">
          {
            clase.temas.map((t: string, i: number) => (
              <li class="flex items-start gap-4 rounded-2xl border border-superficie-borde bg-superficie p-5 sm:p-6">
                <span
                  aria-hidden="true"
                  class="flex size-9 shrink-0 items-center justify-center rounded-full bg-acento-tinte font-bold text-acento-texto"
                >
                  {i + 1}
                </span>
                <span class="pt-1 text-tinta">{t}</span>
              </li>
            ))
          }
        </ol>

        <p class="mt-6 rounded-xl border-l-4 border-acento bg-acento-tinte p-5">
          El contenido detallado de estos temas se añadirá aquí después de la clase
          presencial, para repasar desde casa.
        </p>

        {
          clase.tarea && (
            <Tarea>
              <p>{clase.tarea}</p>
            </Tarea>
          )
        }
      </>
    )
  }
</Layout>